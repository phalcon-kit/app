APP_ENV=local
APP_NAME="Phalcon Kit App"
APP_VERSION=1.0.0
APP_DEBUG=false
APP_CACHE=false
APP_LOGGER=true
APP_TIMEZONE=America/Toronto

# Required before issuing or accepting JWTs: generate a private random key once
# (see README). Never use a shared example key or regenerate it per request.
SECURITY_JWT_PASSPHRASE=

# Required when encryption is used: a separate private key. See README for
# generation and existing-data migration; never rotate it without a data plan.
CRYPT_KEY=

# Same-origin only by default. For credentialed browser clients, list exact
# trusted origins separated by commas and explicitly enable credentials.
RESPONSE_HEADER_ACCESS_CONTROL_ALLOW_ORIGIN=
RESPONSE_HEADER_ACCESS_CONTROL_ALLOW_CREDENTIALS=false

LOCALE_DEFAULT=en
LOCALE_ALLOWED=en

# Optional WebSocket runtime. Keep the default loopback binding when a reverse
# proxy terminates TLS; containers can override the host with 0.0.0.0.
# SWOOLE_HOST=127.0.0.1
# SWOOLE_PORT=8081
# SWOOLE_WORKER_NUM=1
# SWOOLE_MAX_CONNECTIONS=1000

# Configure the database before enabling model-backed services.
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_DBNAME=phalcon_kit
# DATABASE_USERNAME=phalcon_kit
# DATABASE_PASSWORD=
