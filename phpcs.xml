<?xml version="1.0"?>
<ruleset name="Phalcon Kit">
    <description>Phalcon Kit App coding standards for PHP 8.5.</description>

    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg value="p"/>
    <arg value="s"/>
    <config name="php_version" value="80500"/>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
        <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>
        <exclude name="PSR2.Classes.PropertyDeclaration.Underscore"/>
        <exclude name="PSR12.ControlStructures.ControlStructureSpacing"/>
        <exclude name="Squiz.ControlStructures.ControlSignature.SpaceAfterCloseBrace"/>
        <exclude name="Squiz.WhiteSpace.SuperfluousWhitespace.EndLine"/>
    </rule>

    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    <rule ref="Generic.Formatting.DisallowMultipleStatements"/>

    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>bootstrap.php</exclude-pattern>
    </rule>

    <file>src</file>
    <file>tests</file>
    <file>bootstrap.php</file>
    <file>devtools.php</file>
    <file>bin/phalcon-kit</file>
    <file>bin/websocket</file>
    <file>public/index.php</file>

    <exclude-pattern>src/Models/Abstracts/*</exclude-pattern>
    <exclude-pattern>storage/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
</ruleset>
